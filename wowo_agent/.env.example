# 不要把真实密钥提交到 Git。
# OpenAI 或其他 OpenAI 兼容服务
OPENAI_API_KEY=your-api-key
# 智谱也可使用 ZAI_API_KEY，并设置下面三个值：
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# OPENAI_MODEL=glm-5.2
# OPENAI_EMBEDDING_MODEL=embedding-3
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 对话接口不提供 embedding API 时设为 0，知识库将使用本地关键词检索
WOWO_EMBEDDINGS_ENABLED=1
OPENAI_TIMEOUT_SECONDS=180
OPENAI_CONNECT_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=1
WOWO_KNOWLEDGE_DIR=knowledge
WOWO_SKILL_DIR=skills
WOWO_HOST=0.0.0.0
WOWO_PORT=8000
# 若直连 OpenAI 超时，配置本机代理：
# HTTPS_PROXY=http://127.0.0.1:10808
# HTTP_PROXY=http://127.0.0.1:10808
# NO_PROXY=127.0.0.1,localhost
